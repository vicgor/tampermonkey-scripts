{
  "name": "tampermonkey-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Репозиторий устойчивых Tampermonkey-скриптов с единым базовым ядром (lib/agis-core.js).",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "test": "vitest run",
    "validate-meta": "node scripts/validate-meta.js",
    "check-version-bump": "node scripts/check-version-bump.js"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-userscripts": "^0.5.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vitest": "^4.1.12"
  }
}
